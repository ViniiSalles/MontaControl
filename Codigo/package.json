{
  "name": "montacontrol",
  "version": "1.0.0",
  "private": true,
  "description": "MontaControl - sistema de gestão logística e controle operacional para montagem de móveis planejados (TCC PUC Minas)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "api:dev": "pnpm --filter @montacontrol/api start:dev",
    "web:dev": "pnpm --filter @montacontrol/web dev",
    "mobile:start": "pnpm --filter @montacontrol/mobile start",
    "shadow:up": "docker compose -f docker-compose.shadow.yml up -d",
    "shadow:down": "docker compose -f docker-compose.shadow.yml down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.15.0"
  }
}
