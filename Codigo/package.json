{
  "name": "montacontrol",
  "version": "1.0.0",
  "private": true,
  "description": "MontaControl - sistema de gestão logística e controle operacional para montagem de móveis planejados (TCC PUC Minas)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "api:dev": "pnpm --filter @montacontrol/api start:dev",
    "web:dev": "pnpm --filter @montacontrol/web dev",
    "mobile:start": "pnpm --filter @montacontrol/mobile start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
