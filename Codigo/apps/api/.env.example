# Ambiente de desenvolvimento — aponta para o projeto Supabase `MontaControlDev`.
# Copie para `.env` e preencha os valores reais (nunca commitar `.env`).
#
# As três connection strings do Supabase NÃO são intercambiáveis — ver a seção
# "Migrações (Prisma + Supabase)" em Codigo/README.md antes de mexer aqui.

NODE_ENV=development
PORT=3000

# Runtime da API — transaction pooler (porta 6543). DDL falha aqui: nunca usar
# esta URL para migração.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrações (`prisma db push` / `migrate diff` / `migrate deploy`) — session
# pooler (porta 5432), IPv4. Evitar `db.<ref>.supabase.co:5432`: resolve só IPv6.
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

# Supabase Auth (GoTrue) — projeto `MontaControlDev`.
SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="<ANON_OU_PUBLISHABLE_KEY>"
# Settings → API → service_role secret key. NUNCA expor a apps/mobile ou apps/web.
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_JWT_ISSUER="https://<PROJECT_REF>.supabase.co/auth/v1"

# `redirectTo` exigido pelo `resetPasswordForEmail` do GoTrue. O fluxo de
# redefinição usa o código OTP enviado por e-mail (não o clique no link), mas
# o GoTrue ainda exige uma URL válida para o template do e-mail.
PASSWORD_RESET_REDIRECT_URL="https://app.montacontrol.local/redefinir-senha"
