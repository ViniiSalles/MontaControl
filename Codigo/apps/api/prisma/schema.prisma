// Schema Prisma do MontaControl — 20 entidades em 7 domínios de negócio.
// Fonte: DER (Figura 38) e Glossário (Seção 5) do Documento de Projeto v1.7.
//
// Autenticação delegada ao Supabase Auth (GoTrue): `usuario` não guarda hash
// de senha, apenas `authUserId`, o elo com `auth.users.id`. A FK entre
// schemas (`auth.users` não é modelável pelo Prisma sem `multiSchema`) é
// adicionada via SQL cru numa migração dedicada — ver Codigo/README.md.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Perfil {
  GESTOR
  RH
  MONTADOR
  DEPOSITO
}

enum StatusPedido {
  AGUARDANDO
  EM_TRIAGEM
  RECEBIDO
  EM_ENTREGA
  ENTREGUE
}

enum StatusAmbiente {
  PENDENTE
  EM_PROGRESSO
  COMPLETO
}

enum StatusPeca {
  PENDENTE
  TRIADA
  CARREGADA
  /// Bipada pelo montador no descarregamento, no pedido certo (US02/UC03).
  DESCARREGADA
  /// Bipada no descarregamento de outro pedido — peça no caminhão errado (US02/UC04).
  INCONSISTENTE
  ENTREGUE
}

enum StatusAvaria {
  REPORTADA
  EM_ANALISE
  REPOSICAO_SOLICITADA
  RESOLVIDA
}

enum StatusJornada {
  EM_ANDAMENTO
  PAUSADA
  FINALIZADA
}

enum StatusAtestado {
  PENDENTE
  VALIDADO
  REJEITADO
}

/// Ciclo de vida de um lançamento de ponto em atraso. Espelha
/// `StatusSolicitacaoPonto` de `@montacontrol/shared`.
enum StatusSolicitacaoPonto {
  PENDENTE
  APROVADA
  REJEITADA
}

/// Tipo de marcação de ponto original (check-in/check-out) — usado pela
/// tabela `marcacao_ponto` (AFD, Portaria 671/2021). Pontos em atraso
/// aprovados não entram aqui (são tratamento, não marcação original).
enum TipoMarcacao {
  ENTRADA
  SAIDA
}

// ─── Usuário e Autenticação ──────────────────────────────────────────────────

model Usuario {
  id         Int      @id @default(autoincrement())
  nome       String
  email      String   @unique
  telefone   String?
  cpf        String?  @unique @db.VarChar(11)
  authUserId String   @unique @map("auth_user_id") @db.Uuid
  /// Caminho da foto no bucket privado de fotos de usuário (opcional).
  fotoPath   String?  @map("foto_path")
  perfil     Perfil
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  jornadas           Jornada[]
  solicitacoesPonto  SolicitacaoPonto[] @relation("SolicitacaoPontoUsuario")
  pontosAnalisados   SolicitacaoPonto[] @relation("SolicitacaoPontoAnalista")
  atestados          Atestado[]         @relation("AtestadoUsuario")
  atestadosValidados Atestado[]         @relation("AtestadoValidador")
  bancosHoras        BancoHoras[]
  pedidosMontador    PedidoMontador[]
  equipes            EquipeMembro[]
  pecasTriadas       Peca[]             @relation("PecaTriadaPor")
  pecasConferidas    Peca[]             @relation("PecaConferidaPor")
  avariasRegistradas Avaria[]           @relation("AvariaRegistrador")
  avariasAnalisadas  Avaria[]           @relation("AvariaAnalista")
  cautelas           Cautela[]
  epis               Epi[]
  alugueisEpi        AluguelEpi[]       @relation("AluguelEpiUsuario")
  alugueisEpiFeitos  AluguelEpi[]       @relation("AluguelEpiRegistrador")
  devolucoesEpi      AluguelEpi[]       @relation("AluguelEpiDevolucao")
  marcacoesPonto     MarcacaoPonto[]

  @@map("usuario")
}

// ─── Logística: Clientes e Pedidos ───────────────────────────────────────────

model Cliente {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String
  cidade    String
  estado    String
  cep       String
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  telefone  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pedidos Pedido[]

  @@map("cliente")
}

model Pedido {
  id           Int          @id @default(autoincrement())
  clienteId    Int          @map("cliente_id")
  numeroPedido String       @unique @map("numero_pedido")
  status       StatusPedido @default(AGUARDANDO)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  cliente    Cliente          @relation(fields: [clienteId], references: [id])
  ambientes  Ambiente[]
  montadores PedidoMontador[]
  jornadas   Jornada[]

  @@map("pedido")
}

model PedidoMontador {
  id        Int      @id @default(autoincrement())
  pedidoId  Int      @map("pedido_id")
  usuarioId Int      @map("usuario_id")
  /// Data da atribuição: um pedido antigo só fica visível ao montador a partir
  /// dela, então o pull incremental olha esta coluna, e não só `pedido.updated_at`.
  createdAt DateTime @default(now()) @map("created_at")

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([pedidoId, usuarioId])
  @@map("pedido_montador")
}

/// Grupo de montadores que costuma ir junto para a mesma obra. É só um atalho
/// de preenchimento: ao escolher a equipe, o gestor atribui cada membro em
/// `pedido_montador` e pode tirar ou acrescentar pessoas avulsas. A
/// atribuição não guarda a equipe de origem.
model Equipe {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  membros EquipeMembro[]

  @@map("equipe")
}

model EquipeMembro {
  id        Int @id @default(autoincrement())
  equipeId  Int @map("equipe_id")
  usuarioId Int @map("usuario_id")

  equipe  Equipe  @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([equipeId, usuarioId])
  @@map("equipe_membro")
}

// ─── Logística: Ambientes e Peças ────────────────────────────────────────────

model Ambiente {
  id        Int            @id @default(autoincrement())
  pedidoId  Int            @map("pedido_id")
  nome      String
  status    StatusAmbiente @default(PENDENTE)
  updatedAt DateTime       @updatedAt @map("updated_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id])
  pecas  Peca[]

  // Agrupamento automático da triagem (US07/UC09/UC10): mesmo pedido + mesmo
  // nome de ambiente sempre cai na mesma linha, nunca duplica.
  @@unique([pedidoId, nome])
  @@map("ambiente")
}

model Peca {
  id           Int        @id @default(autoincrement())
  ambienteId   Int        @map("ambiente_id")
  /// Agrupa as linhas de um mesmo item do pedido ("card" na tela). Recebe o
  /// `id` da primeira peça criada no grupo — tag de agrupamento, não FK.
  itemId       Int        @map("item_id")
  codigoBarras String?    @unique @map("codigo_barras")
  descricao    String
  /// Peça é um "slot": 150 pregos = 1 linha com quantidade 150, bipada uma única vez.
  quantidade   Int        @default(1)
  status       StatusPeca @default(PENDENTE)
  triadaPor    Int?       @map("triada_por")
  /// Quando a peça chegou ao estoque (bipada na triagem) — base do acompanhamento do gestor.
  triadaAt     DateTime?  @map("triada_at")
  conferidaPor Int?       @map("conferida_por")
  conferidaAt  DateTime?  @map("conferida_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  ambiente   Ambiente @relation(fields: [ambienteId], references: [id])
  triador    Usuario? @relation("PecaTriadaPor", fields: [triadaPor], references: [id])
  conferente Usuario? @relation("PecaConferidaPor", fields: [conferidaPor], references: [id])
  avarias    Avaria[]

  @@index([itemId])
  @@map("peca")
}

// ─── Avarias ─────────────────────────────────────────────────────────────────

model TipoAvaria {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  avarias Avaria[]

  @@map("tipo_avaria")
}

/// Qualquer problema com a peça (dano, falta, defeito), reportado pelo
/// operador (DEPOSITO) ou pelo montador e analisado pelo gestor. A origem
/// sai do perfil de `registrador` — não precisa de coluna própria.
model Avaria {
  id            Int          @id @default(autoincrement())
  pecaId        Int          @map("peca_id")
  tipoAvariaId  Int          @map("tipo_avaria_id")
  registradaPor Int          @map("registrada_por")
  /// UUID do aparelho — idempotência da outbox do mobile, igual ao atestado.
  idCliente     String?      @unique @map("id_cliente") @db.Uuid
  descricao     String
  status        StatusAvaria @default(REPORTADA)
  analisadaPor  Int?         @map("analisada_por")
  analisadaAt   DateTime?    @map("analisada_at")
  parecer       String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  peca        Peca         @relation(fields: [pecaId], references: [id])
  tipoAvaria  TipoAvaria   @relation(fields: [tipoAvariaId], references: [id])
  registrador Usuario      @relation("AvariaRegistrador", fields: [registradaPor], references: [id])
  analista    Usuario?     @relation("AvariaAnalista", fields: [analisadaPor], references: [id])
  fotos       AvariaFoto[]

  @@index([status])
  @@index([registradaPor, updatedAt])
  @@map("avaria")
}

model AvariaFoto {
  id           Int      @id @default(autoincrement())
  avariaId     Int      @map("avaria_id")
  storagePath  String   @map("storage_path")
  mimeType     String   @map("mime_type")
  tamanhoBytes Int      @map("tamanho_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  avaria Avaria @relation(fields: [avariaId], references: [id])

  @@map("avaria_foto")
}

// ─── Jornada e Horas ─────────────────────────────────────────────────────────

model Jornada {
  id                Int           @id @default(autoincrement())
  usuarioId         Int           @map("usuario_id")
  pedidoId          Int?          @map("pedido_id")
  checkinIdCliente  String?       @unique @map("checkin_id_cliente") @db.Uuid
  checkinLatitude   Decimal?      @map("checkin_latitude") @db.Decimal(10, 7)
  checkinLongitude  Decimal?      @map("checkin_longitude") @db.Decimal(10, 7)
  checkinEndereco   String?       @map("checkin_endereco")
  checkinAt         DateTime?     @map("checkin_at")
  checkoutIdCliente String?       @unique @map("checkout_id_cliente") @db.Uuid
  checkoutLatitude  Decimal?      @map("checkout_latitude") @db.Decimal(10, 7)
  checkoutLongitude Decimal?      @map("checkout_longitude") @db.Decimal(10, 7)
  checkoutEndereco  String?       @map("checkout_endereco")
  checkoutAt        DateTime?     @map("checkout_at")
  status            StatusJornada @default(EM_ANDAMENTO)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  pedido  Pedido? @relation(fields: [pedidoId], references: [id])

  /// Preenchida quando a jornada nasceu da aprovação de um ponto em atraso.
  /// É o que responde `JornadaDTO.lancadoEmAtraso` sem coluna redundante.
  solicitacaoPonto SolicitacaoPonto?
  marcacoes        MarcacaoPonto[]

  @@index([usuarioId, checkinAt])
  @@index([usuarioId, updatedAt])
  @@map("jornada")
}

/// Pedido de lançamento de ponto que o montador não conseguiu bater na hora.
/// Nasce PENDENTE e só vira jornada quando um GESTOR aprova — por isso as horas
/// ficam aqui, e não em `jornada`, enquanto a decisão não sai.
model SolicitacaoPonto {
  id                 Int                    @id @default(autoincrement())
  usuarioId          Int                    @map("usuario_id")
  /// UUID gerado no aparelho — idempotência da outbox, igual ao check-in.
  idCliente          String                 @unique @map("id_cliente") @db.Uuid
  /// Dia civil do ponto no fuso de operação, sem hora.
  data               DateTime               @db.Date
  inicio             DateTime
  fim                DateTime
  minutosSolicitados Int                    @map("minutos_solicitados")
  justificativa      String
  status             StatusSolicitacaoPonto @default(PENDENTE)
  /// Jornada criada pela aprovação. Nula enquanto pendente ou se rejeitada.
  jornadaId          Int?                   @unique @map("jornada_id")
  analisadoPor       Int?                   @map("analisado_por")
  analisadoEm        DateTime?              @map("analisado_em")
  motivoRejeicao     String?                @map("motivo_rejeicao")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  usuario  Usuario  @relation("SolicitacaoPontoUsuario", fields: [usuarioId], references: [id])
  analista Usuario? @relation("SolicitacaoPontoAnalista", fields: [analisadoPor], references: [id])
  jornada  Jornada? @relation(fields: [jornadaId], references: [id])

  /// A fila do gestor é sempre "pendentes, mais antigas primeiro".
  @@index([status, data])
  @@index([usuarioId, data])
  @@map("solicitacao_ponto")
}

/// Uma marcação por check-in/check-out original — insumo do AFD (Portaria
/// 671/2021, Anexo V). NSR e hash formam duas cadeias globais e contínuas,
/// nunca reiniciadas por período exportado; ver `JornadasRepository` (NSR)
/// e `afd/marcacoes.repository.ts` (selagem do hash).
model MarcacaoPonto {
  id        Int          @id @default(autoincrement())
  nsr       Int          @unique
  usuarioId Int          @map("usuario_id")
  jornadaId Int          @map("jornada_id")
  tipo      TipoMarcacao
  /// Hora da marcação no aparelho.
  marcadoEm DateTime     @map("marcado_em")
  /// Hora em que o servidor gravou — usada para decidir `offline`.
  gravadoEm DateTime     @map("gravado_em")
  /// `"01"` = aplicativo mobile — único coletor existente hoje.
  coletor   String       @db.Char(2)
  offline   Boolean
  /// SHA-256 do registro tipo 7 (Anexo V); `null` até a selagem, feita sob
  /// demanda pelo `AfdService` antes de cada exportação.
  hash      String?      @db.Char(64)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  jornada Jornada @relation(fields: [jornadaId], references: [id])

  @@unique([jornadaId, tipo])
  @@index([marcadoEm])
  @@map("marcacao_ponto")
}

model BancoHoras {
  id               Int      @id @default(autoincrement())
  usuarioId        Int      @map("usuario_id")
  mes              Int
  ano              Int
  horasTrabalhadas Decimal  @map("horas_trabalhadas") @db.Decimal(7, 2)
  horasPrevistas   Decimal  @map("horas_previstas") @db.Decimal(7, 2)
  saldo            Decimal  @db.Decimal(7, 2)
  calculadoAt      DateTime @default(now()) @map("calculado_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mes, ano])
  @@index([usuarioId, updatedAt])
  @@map("banco_horas")
}

// ─── Atestados ───────────────────────────────────────────────────────────────

model Atestado {
  id             Int            @id @default(autoincrement())
  usuarioId      Int            @map("usuario_id")
  /// UUID gerado no aparelho — idempotência da outbox, igual ao check-in.
  idCliente      String         @unique @map("id_cliente") @db.Uuid
  dataInicio     DateTime       @map("data_inicio") @db.Date
  dataFim        DateTime       @map("data_fim") @db.Date
  observacao     String?
  status         StatusAtestado @default(PENDENTE)
  motivoRejeicao String?        @map("motivo_rejeicao")
  validadoPor    Int?           @map("validado_por")
  validadoAt     DateTime?      @map("validado_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  usuario   Usuario        @relation("AtestadoUsuario", fields: [usuarioId], references: [id])
  validador Usuario?       @relation("AtestadoValidador", fields: [validadoPor], references: [id])
  fotos     AtestadoFoto[]

  @@index([usuarioId, updatedAt])
  @@map("atestado")
}

model AtestadoFoto {
  id           Int      @id @default(autoincrement())
  atestadoId   Int      @map("atestado_id")
  storagePath  String   @map("storage_path")
  mimeType     String   @map("mime_type")
  tamanhoBytes Int      @map("tamanho_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  atestado Atestado @relation(fields: [atestadoId], references: [id])

  @@map("atestado_foto")
}

// ─── Recursos: Ferramentas, Cautelas e EPIs ──────────────────────────────────

model TipoFerramenta {
  id        Int    @id @default(autoincrement())
  nome      String
  descricao String

  ferramentas Ferramenta[]

  @@map("tipo_ferramenta")
}

model Ferramenta {
  id               Int      @id @default(autoincrement())
  tipoFerramentaId Int      @map("tipo_ferramenta_id")
  codigoPatrimonio String   @unique @map("codigo_patrimonio")
  disponivel       Boolean  @default(true)
  ativo            Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  tipoFerramenta TipoFerramenta @relation(fields: [tipoFerramentaId], references: [id])
  cautelas       Cautela[]

  @@map("ferramenta")
}

model Cautela {
  id                    Int       @id @default(autoincrement())
  ferramentaId          Int       @map("ferramenta_id")
  usuarioId             Int       @map("usuario_id")
  dataRetirada          DateTime  @map("data_retirada")
  dataDevolucaoPrevista DateTime  @map("data_devolucao_prevista") @db.Date
  dataDevolucaoReal     DateTime? @map("data_devolucao_real")
  devolvida             Boolean   @default(false)

  ferramenta Ferramenta @relation(fields: [ferramentaId], references: [id])
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  @@map("cautela")
}

model TipoEpi {
  id            Int    @id @default(autoincrement())
  nome          String @unique
  descricao     String
  validadeMeses Int    @map("validade_meses")
  /// Unidades do almoxarifado que o gestor pode alugar ao mesmo tempo.
  estoque       Int    @default(0)

  epis     Epi[]
  alugueis AluguelEpi[]

  @@map("tipo_epi")
}

/// Aluguel (empréstimo temporário) de EPI do almoxarifado, registrado pelo
/// gestor: período reservado (`inicio` → `fimPrevisto`) e a devolução real.
/// O status (reservado, em uso, atrasado, devolvido) é derivado dessas datas.
model AluguelEpi {
  id                     Int       @id @default(autoincrement())
  tipoEpiId              Int       @map("tipo_epi_id")
  usuarioId              Int       @map("usuario_id")
  quantidade             Int       @default(1)
  inicio                 DateTime  @map("inicio")
  fimPrevisto            DateTime  @map("fim_previsto")
  devolvidoEm            DateTime? @map("devolvido_em")
  observacao             String?
  registradoPor          Int       @map("registrado_por")
  devolucaoRegistradaPor Int?      @map("devolucao_registrada_por")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  tipoEpi              TipoEpi  @relation(fields: [tipoEpiId], references: [id])
  usuario              Usuario  @relation("AluguelEpiUsuario", fields: [usuarioId], references: [id])
  registrador          Usuario  @relation("AluguelEpiRegistrador", fields: [registradoPor], references: [id])
  registradorDevolucao Usuario? @relation("AluguelEpiDevolucao", fields: [devolucaoRegistradaPor], references: [id])

  /// Checagem de disponibilidade: aluguéis em aberto de um tipo.
  @@index([tipoEpiId, devolvidoEm])
  @@map("aluguel_epi")
}

model Epi {
  id           Int      @id @default(autoincrement())
  tipoEpiId    Int      @map("tipo_epi_id")
  usuarioId    Int      @map("usuario_id")
  dataEntrega  DateTime @map("data_entrega") @db.Date
  dataValidade DateTime @map("data_validade") @db.Date
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tipoEpi TipoEpi @relation(fields: [tipoEpiId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@map("epi")
}

// ─── Normas ──────────────────────────────────────────────────────────────────

model Norma {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("norma")
}

// ─── Sincronização (offline-first) ───────────────────────────────────────────

/// Registro de exclusões físicas ("tombstones") para o pull incremental do
/// mobile: o aparelho só consegue apagar da réplica local o que o servidor
/// avisa que deixou de existir para ele. `entidade` é o nome da tabela da
/// réplica (`pedidos`, `ambientes`, `pecas`) e `registroId` o id da linha,
/// como texto. `usuarioId` nulo vale para todos os usuários. Sem FK de
/// propósito: o registro deve sobreviver à linha (e ao usuário) que ele descreve.
model SyncExclusao {
  id         Int      @id @default(autoincrement())
  entidade   String
  registroId String   @map("registro_id")
  usuarioId  Int?     @map("usuario_id")
  excluidoEm DateTime @default(now()) @map("excluido_em")

  @@index([usuarioId, excluidoEm])
  @@map("sync_exclusao")
}
