# Testes de integração (e2e) — mesmo alvo do desenvolvimento, `MontaControlDev`.
# Copie para `.env.test` e preencha. NUNCA aponte para o projeto `MontaControl`
# (produção): os testes criam e apagam dados via GoTrue Admin API, e
# `env.validation.ts` recusa subir o processo em NODE_ENV=test se a URL do
# banco for a de produção.
#
# `global-setup` roda `prisma migrate deploy` contra `DIRECT_URL` antes da
# suíte — não precisa de `SHADOW_DATABASE_URL` (isso é só para `migrate dev`).

NODE_ENV=test
PORT=3000

DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="<ANON_OU_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_JWT_ISSUER="https://<PROJECT_REF>.supabase.co/auth/v1"
