# Produção / demo — projeto Supabase `MontaControl`. Alvo só de
# `prisma migrate deploy`, nunca de `prisma db push`.

NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGIAO>.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
SUPABASE_ANON_KEY="<ANON_OU_PUBLISHABLE_KEY>"
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_JWT_ISSUER="https://<PROJECT_REF>.supabase.co/auth/v1"
PASSWORD_RESET_REDIRECT_URL="https://app.montacontrol.local/redefinir-senha"

# Bucket privado do Supabase Storage para fotos de atestado. Criar manualmente
# em Storage → New bucket, com "Public" desligado.
SUPABASE_BUCKET_ATESTADOS=atestados
