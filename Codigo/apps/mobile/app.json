{
  "expo": {
    "name": "MontaControl",
    "slug": "montacontrol",
    "scheme": "montacontrol",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.pucminas.montacontrol",
      "allowBackup": false,
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "br.pucminas.montacontrol"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f9f9f9"
        }
      ],
      "@lovesworking/watermelondb-expo-plugin-sdk-52-plus",
      "./plugins/withCaminhoCurtoCxx",
      [
        "expo-image-picker",
        {
          "photosPermission": "O MontaControl usa a galeria para anexar a foto do atestado.",
          "cameraPermission": "O MontaControl usa a câmera para fotografar atestados e avarias e para ler o código de barras das peças."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O MontaControl usa a câmera para fotografar atestados e avarias e para ler o código de barras das peças.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "newArchEnabled": true, "usePrecompiledModules": false },
          "android": { "newArchEnabled": true }
        }
      ]
    ],
    "extra": {
      "apiUrl": null
    }
  }
}
