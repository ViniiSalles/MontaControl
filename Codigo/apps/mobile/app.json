{
  "expo": {
    "name": "MontaControl",
    "slug": "montacontrol",
    "scheme": "montacontrol",
    "userInterfaceStyle": "light",
    "android": {
      "package": "br.pucminas.montacontrol",
      "allowBackup": false,
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "br.pucminas.montacontrol"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "@lovesworking/watermelondb-expo-plugin-sdk-52-plus",
      [
        "expo-image-picker",
        {
          "photosPermission": "O MontaControl usa a galeria para anexar a foto do atestado.",
          "cameraPermission": "O MontaControl usa a câmera para fotografar o atestado."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": { "newArchEnabled": true, "usePrecompiledModules": false },
          "android": { "newArchEnabled": true }
        }
      ]
    ],
    "extra": {
      "apiUrl": null
    }
  }
}
